[submodule ".registry"]
	path = .registry
	url = https://github.com/rtemis-org/rtemis-org.r-universe.dev
	branch = HEAD
[submodule "croissant"]
	path = croissant
	url = https://github.com/rtemis-org/croissant
[submodule "infoveillance"]
	path = infoveillance
	url = https://github.com/rtemis-org/infoveillance
[submodule "rtemis"]
	path = rtemis
	url = https://github.com/rtemis-org/rtemis
[submodule "rtemis.a3"]
	path = rtemis.a3
	url = https://github.com/rtemis-org/a3
	subdir = r
[submodule "rtemis.core"]
	path = rtemis.core
	url = https://github.com/rtemis-org/rtemis.core
[submodule "rtemis.dplot3"]
	path = rtemis.dplot3
	url = https://github.com/rtemis-org/rtemis.dplot3
[submodule "rtemis.draw"]
	path = rtemis.draw
	url = https://github.com/rtemis-org/draw
	subdir = r
[submodule "rtemis.llm"]
	path = rtemis.llm
	url = https://github.com/rtemis-org/llm
	subdir = r
[submodule "rtemis.server"]
	path = rtemis.server
	url = https://github.com/rtemis-org/rtemis.server
